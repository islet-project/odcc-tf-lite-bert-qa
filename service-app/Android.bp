package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "TfLiteBertQADemoService",
    srcs: [
        "java/**/*.java",
    ],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    static_libs: [
        "org.tensorflow.lite.examples.bertqa-aidl-java",
        "TFLiteTaskTest-lib",
        "TFLiteTaskBase-lib",
    ],
    sdk_version: "system_current",
    jni_libs: [],
    jni_uses_platform_apis: true,
    use_embedded_native_libs: true,
    v4_signature: true,
    min_sdk_version: "33",
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    }
}
